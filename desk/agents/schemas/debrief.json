{
  "title": "Period debrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "what_happened", "why", "against_decisions", "watch", "next_steps", "numbers_cited"],
  "properties": {
    "headline": {"type": "string", "maxLength": 120},
    "what_happened": {"type": "string", "maxLength": 700},
    "why": {"type": "string", "maxLength": 700},
    "against_decisions": {"type": "string", "maxLength": 500},
    "watch": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 160}},
    "next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "symbol"],
        "properties": {
          "text": {"type": "string", "maxLength": 200},
          "symbol": {"type": ["string", "null"]}
        }
      }
    },
    "numbers_cited": {"type": "array", "maxItems": 24, "items": {"type": "string", "maxLength": 80}}
  }
}
