{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desk answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "proposals"],
  "properties": {
    "summary": {"type": "string", "maxLength": 600},
    "proposals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "thesis", "rule_served", "invalidation", "horizon", "numbers_used", "sources", "confidence"],
        "properties": {
          "kind": {"enum": ["buy", "sell", "trim", "rebalance", "harvest", "deposit_route", "hold_off", "alert", "memo"]},
          "title": {"type": "string", "maxLength": 90},
          "symbol": {"type": ["string", "null"]},
          "account": {"type": ["string", "null"]},
          "amount_usd": {"type": ["number", "null"]},
          "shares": {"type": ["number", "null"]},
          "funding": {"enum": ["cash", "deposit", "sale_proceeds", "margin", null]},
          "thesis": {"type": "string", "maxLength": 600},
          "bear_case": {"type": ["string", "null"], "maxLength": 600},
          "rule_served": {"type": "string"},
          "invalidation": {"type": "string"},
          "horizon": {"type": "string"},
          "numbers_used": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "value"],
              "properties": {"field": {"type": "string"}, "value": {"type": ["number", "string"]}}
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "title"],
              "properties": {"url": {"type": "string"}, "title": {"type": "string"}}
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "expires": {"type": ["string", "null"]},
          "order_ticket": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "action": {"enum": ["buy", "sell"]},
              "symbol": {"type": "string"},
              "quantity": {"type": ["number", "null"]},
              "amount_usd": {"type": ["number", "null"]},
              "order_type": {"enum": ["market", "limit"]},
              "limit": {"type": ["number", "null"]},
              "account": {"type": "string"},
              "lot_method": {"enum": ["specific_shares", "fifo", "average", null]}
            }
          }
        }
      }
    }
  }
}
