{
  "title": "Strategy desk answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "action",
    "memo"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "memo": {
      "type": "string",
      "maxLength": 3000
    },
    "action": {
      "enum": [
        "experiment",
        "finalize",
        "rule",
        "lane",
        "none"
      ]
    },
    "experiment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "spec",
        "grid",
        "date_range",
        "seed",
        "trial_budget"
      ],
      "properties": {
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "hypothesis",
            "predicted_effect",
            "universe",
            "signals",
            "entry",
            "exit",
            "rebalance",
            "sizing",
            "params",
            "constraints",
            "success_criteria",
            "horizons"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,48}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 90
            },
            "hypothesis": {
              "type": "string",
              "maxLength": 600
            },
            "predicted_effect": {
              "type": "string",
              "maxLength": 300
            },
            "universe": {
              "type": "object"
            },
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric_id",
                  "window",
                  "transform"
                ],
                "properties": {
                  "metric_id": {
                    "type": "string"
                  },
                  "window": {
                    "type": "string"
                  },
                  "transform": {
                    "type": "string"
                  }
                }
              }
            },
            "entry": {
              "type": [
                "object",
                "string"
              ]
            },
            "exit": {
              "type": [
                "object",
                "string"
              ]
            },
            "rebalance": {
              "type": [
                "object",
                "string"
              ]
            },
            "sizing": {
              "type": [
                "object",
                "string"
              ]
            },
            "params": {
              "type": "object"
            },
            "constraints": {
              "type": "object",
              "required": [
                "long_only",
                "margin",
                "max_position_pct",
                "max_turnover"
              ],
              "properties": {
                "long_only": {
                  "const": true
                },
                "margin": {
                  "const": false
                },
                "max_position_pct": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100
                },
                "max_turnover": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "success_criteria": {
              "type": "object"
            },
            "horizons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  3,
                  5,
                  10
                ]
              }
            },
            "benchmark": {
              "type": [
                "string",
                "null"
              ]
            },
            "account": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "seed": {
          "type": "integer"
        },
        "trial_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "analyses": {
          "type": "array",
          "items": {
            "enum": [
              "param_sensitivity",
              "regime_split",
              "factor_regression",
              "turnover_cost"
            ]
          }
        }
      }
    },
    "finalize": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "version"
      ],
      "properties": {
        "strategy_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "params",
        "horizons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,48}$"
        },
        "rule": {
          "enum": [
            "rebalance_band",
            "deposit_steering",
            "harvest",
            "margin"
          ]
        },
        "params": {
          "type": "object"
        },
        "horizons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              3,
              5,
              10
            ]
          }
        },
        "mix": {
          "type": [
            "object",
            "null"
          ]
        },
        "deposit_monthly": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "start_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        }
      }
    },
    "lane": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "hypothesis",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^filings-[a-z0-9-]{1,23}$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "hypothesis": {
          "type": "string",
          "maxLength": 400
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_direction": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "min_confidence": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 0.95
            },
            "hold_sessions": {
              "type": "integer",
              "minimum": 5,
              "maximum": 60
            },
            "max_names": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20
            },
            "event_types": {
              "type": "array",
              "items": {
                "enum": [
                  "earnings",
                  "guidance",
                  "dilution",
                  "financing",
                  "insider_buy",
                  "insider_sell",
                  "merger_acquisition",
                  "contract",
                  "legal",
                  "management_change",
                  "restatement",
                  "going_concern",
                  "bankruptcy",
                  "delisting",
                  "buyback",
                  "dividend",
                  "product",
                  "regulatory",
                  "other"
                ]
              }
            }
          }
        }
      }
    }
  }
}
