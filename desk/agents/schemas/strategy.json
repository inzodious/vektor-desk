{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy desk answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "action",
    "memo"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "memo": {
      "type": "string",
      "maxLength": 3000
    },
    "action": {
      "enum": [
        "experiment",
        "finalize",
        "none"
      ]
    },
    "experiment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "spec",
        "grid",
        "date_range",
        "seed",
        "trial_budget"
      ],
      "properties": {
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "hypothesis",
            "predicted_effect",
            "universe",
            "signals",
            "entry",
            "exit",
            "rebalance",
            "sizing",
            "params",
            "constraints",
            "success_criteria",
            "horizons"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,48}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 90
            },
            "hypothesis": {
              "type": "string",
              "maxLength": 600
            },
            "predicted_effect": {
              "type": "string",
              "maxLength": 300
            },
            "universe": {
              "type": "object"
            },
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric_id",
                  "window",
                  "transform"
                ],
                "properties": {
                  "metric_id": {
                    "type": "string"
                  },
                  "window": {
                    "type": "string"
                  },
                  "transform": {
                    "type": "string"
                  }
                }
              }
            },
            "entry": {
              "type": [
                "object",
                "string"
              ]
            },
            "exit": {
              "type": [
                "object",
                "string"
              ]
            },
            "rebalance": {
              "type": [
                "object",
                "string"
              ]
            },
            "sizing": {
              "type": [
                "object",
                "string"
              ]
            },
            "params": {
              "type": "object"
            },
            "constraints": {
              "type": "object",
              "required": [
                "long_only",
                "margin",
                "max_position_pct",
                "max_turnover"
              ],
              "properties": {
                "long_only": {
                  "const": true
                },
                "margin": {
                  "const": false
                },
                "max_position_pct": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100
                },
                "max_turnover": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "success_criteria": {
              "type": "object"
            },
            "horizons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  3,
                  5,
                  10
                ]
              }
            },
            "benchmark": {
              "type": [
                "string",
                "null"
              ]
            },
            "account": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "seed": {
          "type": "integer"
        },
        "trial_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "analyses": {
          "type": "array",
          "items": {
            "enum": [
              "param_sensitivity",
              "regime_split",
              "factor_regression",
              "turnover_cost"
            ]
          }
        }
      }
    },
    "finalize": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "version"
      ],
      "properties": {
        "strategy_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
