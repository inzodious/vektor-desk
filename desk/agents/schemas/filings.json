{
  "title": "Filing score",
  "type": "object",
  "additionalProperties": false,
  "required": ["direction", "confidence", "event_type", "horizon_days", "rationale", "numbers_cited"],
  "properties": {
    "direction": {"type": "integer", "minimum": -2, "maximum": 2},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "event_type": {
      "enum": [
        "earnings",
        "guidance",
        "dilution",
        "financing",
        "insider_buy",
        "insider_sell",
        "merger_acquisition",
        "contract",
        "legal",
        "management_change",
        "restatement",
        "going_concern",
        "bankruptcy",
        "delisting",
        "buyback",
        "dividend",
        "product",
        "regulatory",
        "other"
      ]
    },
    "horizon_days": {"type": "integer", "minimum": 1, "maximum": 120},
    "rationale": {"type": "string", "maxLength": 280},
    "numbers_cited": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}}
  }
}
